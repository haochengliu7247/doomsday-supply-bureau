APP_NAME=末日物资鉴定局
APP_HOST=127.0.0.1
APP_PORT=7861
APP_SHARE=false
LOG_LEVEL=INFO

MOCK_MODE=true
VLM_PROVIDER=mock
IMAGE_PROVIDER=mock

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:8b-instruct-q8_0
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=0

COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=workflows/flux2_klein_4b_api.json
COMFYUI_TEXT_WORKFLOW_PATH=workflows/flux2_klein_4b_text_to_image_api.json
COMFYUI_TIMEOUT_SECONDS=180
COMFYUI_POLL_INTERVAL_SECONDS=0.75
COMFYUI_MAX_OUTPUT_MB=30
COMFYUI_MIN_FREE_VRAM_MB=20000
IMAGE_IDENTITY_MAX_ATTEMPTS=2
IMAGE_IDENTITY_MIN_CONFIDENCE=0.8

DATABASE_URL=sqlite:///data/doomsday.db
OUTPUT_DIR=outputs
SCAN_CACHE_ENABLED=true
AI_PIPELINE_LOCK_PATH=data/ai_pipeline.lock
AI_PIPELINE_LOCK_TIMEOUT_SECONDS=600
MAX_UPLOAD_MB=15
IMAGE_MAX_SIDE=1536
